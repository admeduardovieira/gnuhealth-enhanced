msgctxt "help:gnuhealth.insurance.plan.product.policy,discount:"
msgid ""
"Discount in Percentage. It has higher precedence than the fixed price when "
"both values coexist"
msgstr ""
"Procent i rabatt. Det har högre prioritet än det fasta priset när båda "
"värdena samexisterar"

msgctxt "help:gnuhealth.insurance.plan.product.policy,icode:"
msgid "Equivalent product code for this plan"
msgstr "Motsvarande produktkod för denna plan"

msgctxt "help:gnuhealth.insurance.plan.product.policy,price:"
msgid "Apply a fixed price for this product or category"
msgstr "Verkställ ett fast pris för den här produkten eller kategorin"

msgctxt "model:gnuhealth.insurance.plan.product.policy,name:"
msgid "Policy associated to the product on the insurance plan"
msgstr "Försäkringsbrev kopplat till produkten i försäkringsplanen"

msgctxt ""
"model:ir.action,name:action_gnuhealth_insurance_plan_product_policy_view"
msgid "Plan Product Policies"
msgstr "Försäkringsbrev för planprodukter"

msgctxt "model:ir.message,text:msg_discount_without_element"
msgid ""
"SM-INSURANCE-0002: You need to associate a product or category to the "
"discount"
msgstr ""
"SM-INSURANCE-0002: Du måste koppla en produkt eller kategori till rabatten"

msgctxt "model:ir.message,text:msg_need_a_policy"
msgid ""
"SM-INSURANCE-0006: You need to specify either a percentage or a fixed price "
"for this policy line. If both are present, the percentage will be applied"
msgstr ""
"SM-INSURANCE-0006: Du måste ange antingen en procentsats eller ett fast pris"
" för denna försäkringsbrevrad. Om båda anges tillämpas procentsatsen"

msgctxt "model:ir.message,text:msg_no_account_receivable"
msgid ""
"SM-INSURANCE-0007: No Account Receivable defined in party or in default "
"configuration"
msgstr ""
"SM-INSURANCE-0007: Inget kundfordringskonto har angetts för parten eller i "
"standardkonfigurationen"

msgctxt "model:ir.message,text:msg_no_invoice_address"
msgid "SM-INSURANCE-0004: No address associated to the invoice"
msgstr "SM-INSURANCE-0004: Ingen adress är kopplad till fakturan"

msgctxt "model:ir.message,text:msg_no_payment_term"
msgid "SM-INSURANCE-0005: No payment term"
msgstr "SM-INSURANCE-0005: Inget betalningsvillkor har angetts"

msgctxt "model:ir.message,text:msg_pct_out_of_range"
msgid "SM-INSURANCE-0001: Percentage out of range [0-100]"
msgstr "SM-INSURANCE-0001: Procentsatsen ligger utanför intervallet [0–100]"

msgctxt "model:ir.message,text:msg_service_invoiced"
msgid "SM-INSURANCE-0003: The service has been invoiced"
msgstr "SM-INSURANCE-0003: Tjänsten har fakturerats"

